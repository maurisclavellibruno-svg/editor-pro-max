# Do NOT quote these values. Next.js's dotenv loader would strip quotes fine,
# but `docker run --env-file` / Docker Compose's `env_file:` do NOT — the
# quote characters end up as part of the value (e.g. Prisma then sees
# `"postgresql://...` and rejects it as an invalid URL). Keep every value
# below unquoted so both local dev and Docker deployments work identically.

# PostgreSQL
DATABASE_URL=postgresql://maurisbarber:maurisbarber@localhost:5432/maurisbarber?schema=public

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-with-openssl-rand-base64-32

# Admin seed user (used by prisma/seed.ts)
ADMIN_EMAIL=mauris@maurisbarber.com
ADMIN_PASSWORD=change-me-strong-password

# Email notifications (SMTP). Leave empty in dev to just log to console.
# Example values for Resend (https://resend.com — free tier, recommended):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend                      # literal string, not an email
#   SMTP_PASSWORD=re_your_api_key
#   SMTP_FROM_EMAIL=no-reply@maurisbarber.com   # must be on a domain verified in Resend,
#                                                # or use onboarding@resend.dev before verifying one
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@maurisbarber.com
NOTIFICATION_EMAIL=mauris@maurisbarber.com

# Public business info (also editable from the admin panel after seeding)
NEXT_PUBLIC_WHATSAPP_NUMBER=59891552626

# Reminders: how far ahead to remind customers, and how often to scan for
# bookings due a reminder. Sent automatically by the in-process scheduler
# (src/instrumentation.ts). CRON_SECRET is only needed if you'd rather trigger
# GET /api/cron/reminders from an external cron instead.
REMINDER_HOURS_BEFORE=24
REMINDER_CHECK_INTERVAL_MINUTES=15
CRON_SECRET=

# --- Optional external integrations (all no-ops until configured) ---
# See README.md "Integraciones externas" for setup steps and honest caveats
# on each — these are unverified against live credentials.

# Mercado Pago: used by the "Link de pago" button in the agenda.
MERCADOPAGO_ACCESS_TOKEN=

# Stripe: used by the "Link de pago" button in the agenda.
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=uyu

# WhatsApp Business (Meta Cloud API). Not wired into automated reminders —
# see the caveat in src/lib/integrations/whatsapp.ts about message templates.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Google Calendar sync (best-effort, on every new booking).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
