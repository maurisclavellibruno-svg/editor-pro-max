# PostgreSQL
DATABASE_URL="postgresql://maurisbarber:maurisbarber@localhost:5432/maurisbarber?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-with-openssl-rand-base64-32"

# Admin seed user (used by prisma/seed.ts)
ADMIN_EMAIL="mauris@maurisbarber.com"
ADMIN_PASSWORD="change-me-strong-password"

# Email notifications (SMTP). Leave empty in dev to just log to console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
NOTIFICATION_EMAIL="mauris@maurisbarber.com"

# Public business info (also editable from the admin panel after seeding)
NEXT_PUBLIC_WHATSAPP_NUMBER="59891552626"

# Reminders: how far ahead to remind customers, and how often to scan for
# bookings due a reminder. Sent automatically by the in-process scheduler
# (src/instrumentation.ts). CRON_SECRET is only needed if you'd rather trigger
# GET /api/cron/reminders from an external cron instead.
REMINDER_HOURS_BEFORE="24"
REMINDER_CHECK_INTERVAL_MINUTES="15"
CRON_SECRET=""
